{
    "manifest_version": 3,
    "name": "SeeForMe",
    "description": "Conversational form filling. Reasoning runs on your Mac; SeeForMe never submits forms.",
    "version": "1.0",

    "background": {
        "scripts": ["protocol.js", "session.js"],
        "persistent": false
    },

    "content_scripts": [{
        "js": ["dom.js", "content.js"],
        "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
        "run_at": "document_idle",
        "all_frames": false
    }],

    "permissions": ["nativeMessaging", "tabs"]
}
